{
  "rewrites": [
    {
      "source": "/.well-known/farcaster.json",
      "destination": "/api/miniapp-manifest"
    }
  ],
  "headers": [
    {
      "source": "/.well-known/farcaster.json",
      "headers": [
        { "key": "Content-Type", "value": "application/json; charset=utf-8" },
        { "key": "X-Content-Type-Options", "value": "nosniff" }
      ]
    }
  ]
}
